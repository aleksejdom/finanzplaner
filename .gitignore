# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files – enthalten Datenbank-Zugangsdaten und Secrets, nie committen
.env*
!.env.example

# vercel (nicht mehr genutzt, Ordner ggf. lokal noch vorhanden)
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
