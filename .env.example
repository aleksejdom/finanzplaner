# Verbindung zur selbst gehosteten PostgreSQL-Datenbank
DATABASE_URL=postgres://user:password@host:5432/dbname

# Mit `openssl rand -hex 32` oder `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` erzeugen
BETTER_AUTH_SECRET=

# Öffentliche URL der App (in Produktion z. B. https://finanzplaner.example.com)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
